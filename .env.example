# NexusFlow Environment Configuration

# Server Port (Default: 3000)
PORT=3000

# Environment Mode ('development' | 'production')
NODE_ENV=development

# Google Gemini API Key (Optional: Uncapped AI copy generation & semantic SEO)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# n8n Automation Server Webhook Base URL
# Default local instance: http://localhost:5678/
N8N_WEBHOOK_URL="http://localhost:5678/"

# App Base URL (Used for self-referential links, OAuth callbacks, and external redirects)
APP_URL="http://localhost:3000"
