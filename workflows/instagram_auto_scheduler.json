{
  "name": "NexusFlow - Instagram Carousel Generator & Auto-Publisher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "b1c2d3e4-1111-4000-8000-000000000001",
      "name": "Daily Publishing Schedule (09:30 AM)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    id: 'rec_draft_104',\n    fields: {\n      Topic: 'How to scale B2B outbound without burning domain reputation',\n      TargetAudience: 'B2B Founders & Growth Leaders',\n      Status: 'Ready for Generation'\n    }\n  }\n}];"
      },
      "id": "b1c2d3e4-2222-4000-8000-000000000002",
      "name": "Fetch Scheduled Post Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are an elite Instagram growth strategist. Write an educational 4-slide carousel script, caption, and 12 high-engagement niche hashtags for the topic: \" + ($json.fields.Topic || 'B2B Growth Engineering') + \". Output structured JSON with keys: hookHeadline, caption, carouselSlides (array of 4 objects with slide, title, body), hashtags.\"\n    }]\n  }]\n}"
      },
      "continueOnFail": true,
      "id": "b1c2d3e4-3333-4000-8000-000000000003",
      "name": "Gemini Carousel Copywriter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.bannerbear.com/v2/images",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"template\": \"{{ $env.BANNERBEAR_CAROUSEL_TEMPLATE || 'default' }}\",\n  \"modifications\": [\n    { \"name\": \"headline\", \"text\": \"{{ $json.hookHeadline || 'Autonomous B2B Playbook' }}\" }\n  ]\n}"
      },
      "continueOnFail": true,
      "id": "b1c2d3e4-4444-4000-8000-000000000004",
      "name": "Render Carousel PNG Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/{{ $env.INSTAGRAM_ACCOUNT_ID || 'act_test' }}/media",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "media_type", "value": "CAROUSEL" },
            { "name": "caption", "value": "={{ $node['Gemini Carousel Copywriter'].json.caption || 'Scaling with autonomous operations.' }}" }
          ]
        }
      },
      "continueOnFail": true,
      "id": "b1c2d3e4-5555-4000-8000-000000000005",
      "name": "Instagram Graph API Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL || 'https://httpbin.org/post' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"📸 **Instagram Carousel Published**\\nHook: \" + ($node['Gemini Carousel Copywriter'].json.hookHeadline || 'Autonomous Growth Playbook') + \"\\nStatus: Published & Verified\"\n}"
      },
      "continueOnFail": true,
      "id": "b1c2d3e4-6666-4000-8000-000000000006",
      "name": "Discord Confirmation Dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Daily Publishing Schedule (09:30 AM)": {
      "main": [
        [{ "node": "Fetch Scheduled Post Draft", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Scheduled Post Draft": {
      "main": [
        [{ "node": "Gemini Carousel Copywriter", "type": "main", "index": 0 }]
      ]
    },
    "Gemini Carousel Copywriter": {
      "main": [
        [{ "node": "Render Carousel PNG Assets", "type": "main", "index": 0 }]
      ]
    },
    "Render Carousel PNG Assets": {
      "main": [
        [{ "node": "Instagram Graph API Container", "type": "main", "index": 0 }]
      ]
    },
    "Instagram Graph API Container": {
      "main": [
        [{ "node": "Discord Confirmation Dispatch", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
